{
  "manifest_version": 3,
  "name": "UIU UCAM Evaluation Automator",
  "version": "1.0.2",
  "description": "Automates UIU UCAM Course Evaluation login, navigation, grade selection, and questions.",
  "author": "IRFAN HAIDER ABIR",
  "developer": {
    "name": "IRFAN HAIDER ABIR"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://ucam.uiu.ac.bd/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "uiu-ucam-evaluator@irfanhaiderabir",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://ucam.uiu.ac.bd/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
